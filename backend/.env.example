# Copy this file to .env and fill it in. Never commit .env.

# true = demo mode with five sample client tenants. false = live Microsoft 365 tenants.
USE_MOCK_DATA=true

# Demo mode: how long each sample-data call pauses so scans look like real jobs (0 = instant)
MOCK_DELAY_MS=400

# Live mode, one tenant: the Azure app registration for that tenant
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Live mode, several tenants: path to a JSON file listing them (see README)
CLIENTS_FILE=clients.json

# Scan every client automatically every N hours, and once when the server starts
SCAN_INTERVAL_HOURS=24
SCAN_ON_START=true

# Leave empty to keep data in memory, or set a PostgreSQL connection string
# Example: postgres://postgres:password@localhost:5432/northwatch
DATABASE_URL=

# Any long random string, used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

PORT=5000
